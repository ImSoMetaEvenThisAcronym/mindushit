type: GenericCrafter
name: "Void Reactor"
description: '''
Energizes Glitch Matter and fuses it with Thorium to create unstable pseudomass particles. Infuses these particles into Ichor to form Void Fluid.
Returns Phase Fabric to be reused.
'''
ambientSound: bioLoop
ambientSoundVolume: 0.2
size: 4
hasPower: false
consumes: {
  liquids: [
    ichor/3
  ]
  items: [
    contained-glitch-matter/1
    thorium/4
  ]
}
liquidCapacity: 600
itemCapacity: 20
drawer: [
  {
    type: DrawRegion
    suffix: -bottom
  }
  {
    type: DrawCells
    color: 000000
    particleColorFrom: ff0000
    particleColorTo: 00ffff
    particles: 30
    range: 7
  }
  DrawDefault
]
craftTime: 60
outputLiquids: [
  voidfluid/0.3
]
outputItems: [
  phase-fabric/1
]
liquidCapacity: 300
category: crafting
requirements: [
  surge-alloy/100
  phase-fabric/75
  thorium/170
  metaglass/100
]
